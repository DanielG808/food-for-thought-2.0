{
  "name": "food-for-thought-2-0",
  "private": true,
  "workspaces": [
    "web",
    "mobile",
    "packages/*"
  ],
  "scripts": {
    "db:status": "npm exec prisma migrate status --schema packages/db/prisma/schema.prisma",
    "db:migrate": "npm exec prisma migrate dev -- --schema packages/db/prisma/schema.prisma",
    "db:push": "npm exec prisma db push --schema packages/db/prisma/schema.prisma",
    "db:generate": "npm exec prisma generate -- --schema packages/db/prisma/schema.prisma",
    "db:studio": "npm exec prisma studio -- --schema packages/db/prisma/schema.prisma",
    "db:format": "npm exec prisma format -- --schema packages/db/prisma/schema.prisma",
    "dev:web": "npm --workspace web run dev",
    "build:web": "npm --workspace web run build",
    "lint": "npm --workspace web run lint",
    "typecheck": "npm --workspace web run typecheck"
  },
  "devDependencies": {
    "prisma": "^6.14.0"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0"
  }
}
